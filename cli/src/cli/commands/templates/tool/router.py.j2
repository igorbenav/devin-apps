"""HTML routes for the << label >> tool.

Mounted by the platform at the ToolSpec's ``route_prefix``; every route is
behind the tool's permission, and no route writes directly — they call
``service``.
"""

from typing import Annotated, Any

from fastapi import APIRouter, Depends, Form, Request

from ....infrastructure.dependencies import AsyncSessionDep
from ...platform.dependencies import ViewerContext, require_page_permission
from ...platform.templating import render
from . import service
from .tool import SPEC

router = APIRouter(include_in_schema=False)

ViewerDep = Annotated[ViewerContext, Depends(require_page_permission(SPEC.required_permission))]


@router.get("")
async def list_page(request: Request, db: AsyncSessionDep, viewer: ViewerDep) -> Any:
    """List page."""
    items = await service.list_items(db)
    return render(request, "<< slug >>/list.html", viewer=viewer, context={"items": items, "tool": SPEC})


@router.post("")
async def create_item(
    request: Request,
    db: AsyncSessionDep,
    viewer: ViewerDep,
    title: Annotated[str, Form()],
    notes: Annotated[str | None, Form()] = None,
) -> Any:
    """HTMX action: create an item and append its row."""
    item = await service.create_item(db, viewer.user, title, notes)
    return render(request, "<< slug >>/_row.html", viewer=viewer, context={"item": item})


@router.get("/{item_id}")
async def detail_page(request: Request, db: AsyncSessionDep, viewer: ViewerDep, item_id: int) -> Any:
    """Detail page for one item."""
    item = await service.get_item(db, item_id)
    return render(request, "<< slug >>/detail.html", viewer=viewer, context={"item": item, "tool": SPEC})


@router.post("/{item_id}/complete")
async def complete_item(request: Request, db: AsyncSessionDep, viewer: ViewerDep, item_id: int) -> Any:
    """HTMX action: complete an item and swap the row it lives in."""
    item = await service.complete_item(db, viewer.user, item_id)
    return render(request, "<< slug >>/_row.html", viewer=viewer, context={"item": item})
